{
  "name": "algolens-dsa-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,UI -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:ui": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:pages": "vite build --base=/dsa-visualizer-ide/",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
